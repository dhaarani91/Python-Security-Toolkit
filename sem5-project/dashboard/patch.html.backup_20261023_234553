<script>

/* =========================================================
   PATCH SCAN
========================================================= */

let scanRunning = false;

async function runPatchScan() {
    if (scanRunning) return;
    scanRunning = true;

    const scanButton = document.getElementById("scanButton");
    const bottomButton = document.getElementById("bottomScanButton");
    const scannerIcon = document.getElementById("scannerIcon");
    const scannerTitle = document.getElementById("scannerTitle");
    const scannerMessage = document.getElementById("scannerMessage");

    if (scanButton) scanButton.disabled = true;
    if (bottomButton) bottomButton.disabled = true;
    if (scannerIcon) scannerIcon.classList.add("scanning");

    if (scannerTitle) scannerTitle.innerText = "Scanning managed VMs...";
    if (scannerMessage) {
        scannerMessage.innerText =
            "Collecting installed packages and available updates from the backend...";
    }

    try {
        const response = await fetch("/api/patch-status", {
            method: "GET",
            headers: { "Accept": "application/json" },
            cache: "no-store"
        });

        const data = await response.json();

        if (!response.ok || !data.success) {
            throw new Error(data.error || `Patch scan failed (HTTP ${response.status})`);
        }

        const summary = data.summary || {};
        const hosts = Object.values(data.hosts || {});
        const packages = Array.isArray(data.packages) ? data.packages : [];

        document.getElementById("installedPackages").innerText =
            Number(summary.installed_packages ?? 0).toLocaleString();

        document.getElementById("availableUpdates").innerText =
            Number(summary.available_updates ?? 0).toLocaleString();

        document.getElementById("securityUpdates").innerText =
            Number(summary.security_updates ?? 0).toLocaleString();

        // Installed package counts alone do not establish compliance.
        document.getElementById("patchCompliance").innerText = "N/A";
        document.getElementById("progressValue").innerText = "N/A";
        document.getElementById("progressFill").style.width = "0%";

        const rebootCount = Number(summary.reboot_required_vms ?? 0);
        const updateCount = Number(summary.available_updates ?? 0);
        const aptChecksSucceeded = hosts.length > 0 &&
            hosts.every(host => host.apt_query_succeeded === true);

        document.getElementById("vmPatchStatus").innerText =
            !aptChecksSucceeded ? "PARTIAL DATA" :
            (updateCount > 0 || rebootCount > 0 ? "UPDATES AVAILABLE" : "NO UPDATES FOUND");

        document.getElementById("updatesText").innerText =
            !aptChecksSucceeded ? "Some package update checks could not be confirmed" :
            (updateCount > 0
                ? `${updateCount} package updates available`
                : "No updates listed in the existing APT cache");

        if (scannerTitle) scannerTitle.innerText = "Patch Scan Completed";
        if (scannerMessage) {
            scannerMessage.innerText =
                `${hosts.length} VM(s) checked. ` +
                `${updateCount} available updates; ${rebootCount} VM(s) require reboot. ` +
                (data.cache_note || "");
        }

        // Render real backend package data using the existing five-column table.
        const table = document.getElementById("packageTable");
        if (table) {
            table.replaceChildren();

            if (packages.length === 0) {
                const row = table.insertRow();
                const cell = row.insertCell();
                cell.colSpan = 5;
                cell.textContent = "No package records were returned by the API.";
            } else {
                for (const pkg of packages) {
                    const name = String(pkg.name ?? "Unknown");
                    const installed = String(pkg.installed_version ?? "Unknown");
                    const latest = String(pkg.latest_version ?? "Not available");
                    const status = String(pkg.status ?? "Unknown");

                    const row = table.insertRow();
                    row.dataset.status = status.toLowerCase();

                    const nameCell = row.insertCell();
                    nameCell.className = "package-name";
                    nameCell.textContent = name;

                    const installedCell = row.insertCell();
                    installedCell.className = "package-version";
                    installedCell.textContent = installed;

                    const latestCell = row.insertCell();
                    latestCell.className = "package-version";
                    latestCell.textContent = latest;

                    const statusCell = row.insertCell();
                    const badge = document.createElement("span");
                    badge.className = "badge " +
                        (status.toLowerCase() === "updated" ? "updated" : "pending");
                    badge.textContent = status;
                    statusCell.appendChild(badge);

                    const actionCell = row.insertCell();
                    const button = document.createElement("button");
                    button.className = "package-action";
                    button.type = "button";
                    button.innerHTML = '<i class="fa-solid fa-eye"></i> Details';
                    button.addEventListener("click", () => {
                        showPackageDetails(name, installed, latest, status);
                    });
                    actionCell.appendChild(button);
                }
            }
        }

        if (typeof showToast === "function") {
            showToast("Patch Scan Completed",
                `${hosts.length} VM(s) checked; ${updateCount} available updates found.`);
        }
    } catch (error) {
        console.error("Patch status API error:", error);
        if (scannerTitle) scannerTitle.innerText = "Patch Scan Failed";
        if (scannerMessage) scannerMessage.innerText =
            error.message || "Unable to retrieve patch status from the backend.";

        if (document.getElementById("vmPatchStatus")) {
            document.getElementById("vmPatchStatus").innerText = "SCAN FAILED";
        }

        if (typeof showToast === "function") {
            showToast("Patch Scan Failed",
                error.message || "Could not retrieve patch status.");
        }
    } finally {
        scanRunning = false;
        if (scanButton) scanButton.disabled = false;
        if (bottomButton) bottomButton.disabled = false;
        if (scannerIcon) scannerIcon.classList.remove("scanning");
    }
}

/* =========================================================
   PACKAGE SEARCH / FILTER
========================================================= */

function filterPackages() {

    const search =
        document.getElementById("packageSearch")
        .value
        .toLowerCase();

    const filter =
        document.getElementById("packageFilter")
        .value;

    const rows =
        document.querySelectorAll(
            "#packageTable tr"
        );

    rows.forEach(function(row) {

        const text =
            row.innerText.toLowerCase();

        const status =
            row.dataset.status;

        const searchMatch =
            text.includes(search);

        const filterMatch =
            filter === "all" ||
            status === filter;

        if (searchMatch && filterMatch) {

            row.style.display = "";

        } else {

            row.style.display = "none";

        }

    });

}


/* =========================================================
   PACKAGE DETAILS
========================================================= */

function showPackageDetails(
    name,
    installed,
    latest,
    status
) {

    document.getElementById("modalPackage")
        .innerText = name;

    document.getElementById("modalInstalled")
        .innerText = installed;

    document.getElementById("modalLatest")
        .innerText = latest;

    document.getElementById("modalStatus")
        .innerText = status;

    document.getElementById("packageModal")
        .classList.add("show");

}


function closePackageModal() {

    document.getElementById("packageModal")
        .classList.remove("show");

}


/* =========================================================
   CLICK OUTSIDE MODAL
========================================================= */

document.getElementById("packageModal")
.addEventListener("click", function(event) {

    if (event.target === this) {

        closePackageModal();

    }

});


/* =========================================================
   TOAST
========================================================= */

function showToast(title, message) {

    const toast =
        document.getElementById("toast");

    document.getElementById("toastTitle")
        .innerText = title;

    document.getElementById("toastMessage")
        .innerText = message;

    toast.classList.add("show");

    setTimeout(function() {

        toast.classList.remove("show");

    }, 4000);

}


/* =========================================================
   HISTORY
========================================================= */

function addHistoryEntry(
    activity,
    result
) {

    const table =
        document.getElementById("historyTable");

    const row =
        document.createElement("tr");

    const now =
        new Date();

    const date =
        now.toLocaleDateString(
            "en-GB",
            {
                day: "2-digit",
                month: "short",
                year: "numeric"
            }
        );

    row.innerHTML = `

        <td>${date}</td>

        <td>${activity}</td>

        <td>
            <span class="badge pass">
                ${result}
            </span>
        </td>

        <td>
            Python CSPM Scanner
        </td>

    `;

    table.insertBefore(
        row,
        table.firstChild
    );

}


/* =========================================================
   INITIAL STATE
========================================================= */

document.addEventListener("DOMContentLoaded", function() {
    document.getElementById("installedPackages").innerText = "—";
    document.getElementById("availableUpdates").innerText = "—";
    document.getElementById("securityUpdates").innerText = "—";
    document.getElementById("patchCompliance").innerText = "N/A";
    document.getElementById("progressValue").innerText = "N/A";
    document.getElementById("progressFill").style.width = "0%";
});

</script>

