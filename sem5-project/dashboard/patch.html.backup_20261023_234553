/* =========================================================
   PATCH MANAGEMENT PAGE
   ========================================================= */

.page-subtitle {
    color: #94a3b8;
    margin-top: 6px;
}

.header-actions {
    display: flex;
    gap: 10px;
    align-items: center;
}

/* VM Status */

.vm-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 12px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: bold;
    background: rgba(34,197,94,0.12);
    color: #22c55e;
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
}

/* Buttons */

.patch-btn {
    border: none;
    padding: 11px 17px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: 0.2s ease;
}

.patch-btn:hover {
    transform: translateY(-1px);
    opacity: 0.9;
}

.primary-btn {
    background: #2563eb;
    color: white;
}

.secondary-btn {
    background: rgba(255,255,255,0.08);
    color: #e2e8f0;
}

.success-btn {
    background: #16a34a;
    color: white;
}

.warning-btn {
    background: #d97706;
    color: white;
}

.danger-btn {
    background: #dc2626;
    color: white;
}

.patch-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
}

/* Summary cards */

.patch-card {
    position: relative;
    overflow: hidden;
}

.patch-card .card-icon {
    font-size: 25px;
    margin-bottom: 10px;
}

.patch-card small {
    display: block;
    color: #94a3b8;
    margin-top: 6px;
}

/* Panels */

.patch-panel {
    margin-top: 22px;
}

/* VM information */

.vm-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin-top: 18px;
}

.vm-info {
    padding: 16px;
    border-radius: 10px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
}

.vm-info span {
    display: block;
    color: #94a3b8;
    font-size: 13px;
    margin-bottom: 7px;
}

.vm-info strong {
    font-size: 16px;
}

/* Patch progress */

.progress-container {
    margin-top: 18px;
}

.progress-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
}

.progress-bar {
    width: 100%;
    height: 12px;
    background: rgba(255,255,255,0.08);
    border-radius: 10px;
    overflow: hidden;
}

.progress-fill {
    width: 100%;
    height: 100%;
    border-radius: 10px;
    transition: width 0.5s ease;
}

/* Package search */

.package-toolbar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 15px;
    flex-wrap: wrap;
}

.search-box {
    position: relative;
    flex: 1;
    min-width: 220px;
}

.search-box i {
    position: absolute;
    left: 13px;
    top: 13px;
    color: #94a3b8;
}

.search-box input {
    width: 100%;
    box-sizing: border-box;
    padding: 11px 12px 11px 38px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.05);
    color: white;
    outline: none;
}

.filter-select {
    padding: 11px 14px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.1);
    background: #172033;
    color: white;
    outline: none;
}

/* Package rows */

.package-name {
    font-weight: 600;
}

.package-version {
    font-family: monospace;
    color: #cbd5e1;
}

.package-action {
    padding: 7px 11px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    background: rgba(37,99,235,0.18);
    color: #60a5fa;
}

.package-action:hover {
    background: rgba(37,99,235,0.3);
}

/* Badges */

.badge.updated {
    background: rgba(34,197,94,0.15);
    color: #22c55e;
}

.badge.pending {
    background: rgba(245,158,11,0.15);
    color: #f59e0b;
}

.badge.critical {
    background: rgba(239,68,68,0.15);
    color: #ef4444;
}

/* Scanner */

.scanner-box {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px;
    border-radius: 10px;
    background: rgba(37,99,235,0.08);
    border: 1px solid rgba(37,99,235,0.18);
}

.scanner-icon {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(37,99,235,0.18);
    font-size: 21px;
}

.scanner-text h3 {
    margin: 0 0 5px;
}

.scanner-text p {
    margin: 0;
    color: #94a3b8;
}

/* Modal */

.modal {
    display: none;
    position: fixed;
    z-index: 9999;
    inset: 0;
    background: rgba(0,0,0,0.72);
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.modal.show {
    display: flex;
}

.modal-content {
    width: 100%;
    max-width: 550px;
    background: #111827;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px;
    padding: 25px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.close-modal {
    border: none;
    background: transparent;
    color: #94a3b8;
    font-size: 22px;
    cursor: pointer;
}

.detail-row {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 13px 0;
    border-bottom: 1px solid rgba(255,255,255,0.07);
}

.detail-row:last-child {
    border-bottom: none;
}

.detail-row span {
    color: #94a3b8;
}

/* Toast */

.toast {
    position: fixed;
    right: 25px;
    bottom: 25px;
    z-index: 10000;
    min-width: 280px;
    max-width: 380px;
    padding: 15px 18px;
    border-radius: 10px;
    background: #111827;
    border: 1px solid rgba(255,255,255,0.1);
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    display: none;
}

.toast.show {
    display: block;
    animation: toastIn 0.25s ease;
}

@keyframes toastIn {
    from {
        opacity: 0;
        transform: translateY(15px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Scan animation */

.scanning {
    animation: pulseScan 1s infinite;
}

@keyframes pulseScan {
    0%,100% {
        transform: scale(1);
        opacity: 1;
    }

    50% {
        transform: scale(1.08);
        opacity: 0.65;
    }
}

/* Responsive */

@media (max-width: 1000px) {

