/* =========================================================
   SENTINELFORGE - REPORT MANAGEMENT
   Uses real backend data and saved report files.
   Does not trigger scans or modify VMs.
   ========================================================= */

const API_BASE = "http://127.0.0.1:5000";

let reportData = null;
let securityData = null;
let libraryData = null;


/* =========================================================
   TOAST MESSAGES
   ========================================================= */

function showToast(message, type = "info") {
    let container = document.getElementById("toastContainer");

    if (!container) {
        container = document.createElement("div");
        container.id = "toastContainer";
        document.body.appendChild(container);
    }

    const toast = document.createElement("div");
    toast.className = "toast " + type;
    toast.textContent = message;

    container.appendChild(toast);

    setTimeout(() => toast.remove(), 3500);
}


/* =========================================================
   SAFE API REQUEST
   ========================================================= */

async function fetchJSON(endpoint) {
    const response = await fetch(`${API_BASE}${endpoint}`, {
        method: "GET",
        cache: "no-store"
    });

    if (!response.ok) {
        throw new Error(
            `${endpoint}: HTTP ${response.status}`
        );
    }

    return response.json();
}


/* =========================================================
   LOAD REPORT DATA
   ========================================================= */

async function loadReport() {
    const status = document.getElementById("resultsStatus");

    try {
        // Current security checks from collected VM settings.
        securityData = await fetchJSON("/api/security");

        // Latest timestamped scan report.
        try {
            reportData = await fetchJSON("/api/report");
        } catch (error) {
            console.warn(
                "Latest historical report unavailable:",
                error
            );

            reportData = null;
        }

        // Actual saved JSON reports and PDFs.
        try {
            libraryData = await fetchJSON("/api/reports/library");
        } catch (error) {
            console.warn(
                "Saved report library unavailable:",
                error
            );

            libraryData = null;
        }

        updateReportUI();
        renderReportHistory();

        if (status) {
            status.className = "status-box status-success";
            status.textContent =
                "Security data loaded from the SENTINELFORGE backend.";
        }

    } catch (error) {
        console.error("Unable to load report data:", error);

        if (status) {
            status.className = "status-box status-error";
            status.textContent =
                "Unable to load security data. Check whether the Flask API is running.";
        }

        showToast(
            "Could not load security report data.",
            "error"
        );
    }
}


/* =========================================================
   GET CURRENT SECURITY CHECKS
   ========================================================= */

function getRules() {
    if (
        !securityData ||
        !Array.isArray(securityData.rules)
    ) {
        return [];
    }

    return securityData.rules;
}


/* =========================================================
   CALCULATE SUMMARY
   ========================================================= */

function getSummary() {
    const rules = getRules();

    const passed = rules.filter(
        rule => rule.status === "PASS"
    ).length;

    const failed = rules.filter(
        rule => rule.status === "FAIL"
    ).length;

    const info = rules.filter(
        rule => rule.status === "INFO"
    ).length;

    const unknown = rules.filter(
        rule => !["PASS", "FAIL", "INFO"].includes(rule.status)
    ).length;

    const evaluated = passed + failed;

    return {
        total: rules.length,
        passed,
        failed,
        info,
        unknown,

        compliance: evaluated
            ? (passed / evaluated) * 100
            : 0,

        risk: evaluated
            ? (failed / evaluated) * 100
            : 0
    };
}


/* =========================================================
   FORMAT VALUES
   ========================================================= */

function formatPercent(value) {
    if (
        value === null ||
        value === undefined ||
        !Number.isFinite(value)
    ) {
        return "--";
    }

    return `${value.toFixed(1)}%`;
}


function formatDate(value) {
    if (!value) {
        return "Unavailable";
    }

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
        return "Unavailable";
    }

    return date.toLocaleString();
}


function formatFileSize(bytes) {
    if (!Number.isFinite(Number(bytes))) {
        return "Size unavailable";
    }

    const size = Number(bytes);

    if (size < 1024) {
        return `${size} B`;
    }

    if (size < 1024 * 1024) {
        return `${(size / 1024).toFixed(1)} KB`;
    }

    return `${(size / (1024 * 1024)).toFixed(1)} MB`;
}


function setText(id, value) {
    const element = document.getElementById(id);

    if (element) {
        element.textContent = value;
    }
}


function setBadge(id, text, className) {
    const element = document.getElementById(id);

    if (!element) {
        return;
    }

    element.textContent = text;
    element.className = `badge ${className}`;
}


/* =========================================================
   REPORT LIBRARY HELPERS
   ========================================================= */

function getJSONReports() {
    if (
        !libraryData ||
        !Array.isArray(libraryData.json_reports)
    ) {
        return [];
    }

    return libraryData.json_reports;
}


function getPDFReports() {
    if (
        !libraryData ||
        !Array.isArray(libraryData.pdf_reports)
    ) {
        return [];
    }

    return libraryData.pdf_reports;
}


function getLatestJSONReport() {
    return getJSONReports()[0] || null;
}


function getLatestPDFReport() {
    return getPDFReports()[0] || null;
}


/* =========================================================
   UPDATE REPORT PAGE
   ========================================================= */

function updateReportUI() {
    const summary = getSummary();
    const evaluated = summary.passed + summary.failed;

    const controller = securityData?.controller || {};

    const hosts = Array.isArray(securityData?.hosts)
        ? securityData.hosts
        : [];

    const jsonReports = getJSONReports();
    const pdfReports = getPDFReports();

    const jsonAvailable =
        !!libraryData &&
        jsonReports.length > 0;

    const pdfAvailable =
        !!libraryData &&
        pdfReports.length > 0;


    /* Scanner information */

    setText(
        "scannerName",
        securityData?.scanner?.name || "SENTINELFORGE"
    );

    setText(
        "scannerVersion",
        securityData?.scanner?.version || "Not configured"
    );

    setText(
        "framework",
        securityData?.framework || "Not configured"
    );


    /* Security summary */

    setText("totalChecks", summary.total);
    setText("passedChecks", summary.passed);
    setText("failedChecks", summary.failed);

    // The existing page has one information counter.
    // INFO and UNKNOWN remain separate in the JSON report.
    setText("infoChecks", summary.info + summary.unknown);

    const compliance = evaluated
        ? formatPercent(summary.compliance)
        : "--";

    const risk = evaluated
        ? formatPercent(summary.risk)
        : "--";

    setText("complianceScore", compliance);
    setText("riskScore", risk);
    setText("summaryCompliance", compliance);
    setText("summaryRisk", risk);


    /* Controller and target information */

    const controllerOS = [
        controller.operating_system,
        controller.os_release
    ].filter(Boolean).join(" ");

    setText(
        "controllerOS",
        controllerOS || "Controller information unavailable"
    );

    setText(
        "reportTarget",
        hosts.length
            ? hosts.join(", ")
            : "Host information unavailable"
    );


    /* Latest report timestamp */

    const latestTimestamp =
        reportData?.timestamp ||
        securityData?.timestamp ||
        null;

    setText(
        "latestReportTime",
        latestTimestamp
            ? formatDate(latestTimestamp)
            : "Timestamp unavailable"
    );


    /* Saved JSON report information */

    setText(
        "jsonCount",
        libraryData
            ? jsonReports.length
            : "Unavailable"
    );

    const latestJSON = getLatestJSONReport();

    setText(
        "jsonDate",
        latestJSON
            ? formatDate(latestJSON.modified * 1000)
            : "No saved JSON reports"
    );

    setBadge(
        "jsonStatus",
        jsonAvailable
            ? "Available"
            : libraryData
                ? "No saved reports"
                : "Unavailable",
        jsonAvailable ? "pass" : "info"
    );


    /* Saved PDF information */

    setText(
        "pdfCount",
        libraryData
            ? pdfReports.length
            : "Unavailable"
    );

    const latestPDF = getLatestPDFReport();

    setText(
        "pdfDate",
        latestPDF
            ? formatDate(latestPDF.modified * 1000)
            : "No saved PDFs"
    );

    setBadge(
        "pdfStatus",
        pdfAvailable
            ? "Available"
            : libraryData
                ? "No saved PDFs"
                : "Unavailable",
        pdfAvailable ? "pass" : "info"
    );


    /* Enable PDF viewing only when a real saved PDF exists */

    const viewButton = document.getElementById("viewPdfBtn");

    if (viewButton) {
        viewButton.disabled = !pdfAvailable;
    }


    /* Update the latest-report panel if it exists */

    const latestPanel = Array.from(
        document.querySelectorAll(".panel")
    ).find(panel =>
        panel.textContent.includes("Controller:") &&
        panel.textContent.includes("Target:")
    );

    if (latestPanel) {
        const heading = latestPanel.querySelector("h3");

        if (heading) {
            heading.textContent = "Latest Available Report";
        }

        latestPanel.querySelectorAll("p").forEach(paragraph => {
            const text = paragraph.textContent;

            if (text.includes("Controller:")) {
                paragraph.textContent =
                    `Controller: ${controllerOS || "Unavailable"}`;

            } else if (text.includes("Target:")) {
                paragraph.textContent =
                    `Target: ${hosts.length ? hosts.join(", ") : "Unavailable"}`;

            } else if (text.includes("Report Source:")) {
                paragraph.textContent =
                    `Report Source: ${securityData?.source || "Flask API"}`;
            }
        });
    }
}


/* =========================================================
   RENDER SAVED REPORT HISTORY
   ========================================================= */

function renderReportHistory() {
    if (!libraryData) {
        return;
    }

    let historyPanel = document.getElementById(
        "dynamicReportHistory"
    );

    if (!historyPanel) {
        historyPanel = document.createElement("section");
        historyPanel.id = "dynamicReportHistory";
        historyPanel.className = "panel";

        historyPanel.innerHTML = `
            <h3>Saved Report History</h3>

            <div>
                <h4>JSON Reports</h4>
                <div id="savedJSONHistory"></div>
            </div>

            <div style="margin-top: 20px;">
                <h4>PDF Reports</h4>
                <div id="savedPDFHistory"></div>
            </div>
        `;

        const mainContent =
            document.querySelector("main") ||
            document.querySelector(".main-content") ||
            document.querySelector(".content") ||
            document.querySelector(".dashboard-content");

        (mainContent || document.body).appendChild(historyPanel);
    }

    renderHistoryList(
        "savedJSONHistory",
        getJSONReports(),
        "JSON"
    );

    renderHistoryList(
        "savedPDFHistory",
        getPDFReports(),
        "PDF"
    );
}


function renderHistoryList(containerId, reports, type) {
    const container = document.getElementById(containerId);

    if (!container) {
        return;
    }

    container.replaceChildren();

    if (reports.length === 0) {
        const message = document.createElement("p");

        message.textContent = `No saved ${type} reports found.`;

        container.appendChild(message);
        return;
    }

    const list = document.createElement("div");

    reports.forEach(report => {
        const item = document.createElement("div");

        item.style.padding = "10px 0";
        item.style.borderBottom = "1px solid #ddd";

        const name = document.createElement("strong");
        name.textContent = report.name || "Unnamed report";

        const details = document.createElement("p");

        details.textContent =
            `Modified: ${formatDate(report.modified * 1000)} | ` +
            `Size: ${formatFileSize(report.size_bytes)}`;

        details.style.margin = "5px 0";

        item.appendChild(name);
        item.appendChild(details);

        if (type === "PDF") {
            const link = document.createElement("a");

            link.href =
                `${API_BASE}/api/reports/pdf/` +
                encodeURIComponent(report.name);

            link.target = "_blank";
            link.rel = "noopener noreferrer";
            link.textContent = "View PDF";

            item.appendChild(link);
        }

        list.appendChild(item);
    });

    container.appendChild(list);
}


/* =========================================================
   VIEW CURRENT SECURITY REPORT JSON
   ========================================================= */

async function viewScannerResults() {
    const panel = document.getElementById("scannerResults");
    const status = document.getElementById("resultsStatus");
    const viewer = document.getElementById("jsonViewer");

    if (!panel || !status || !viewer) {
        showToast("Report viewer elements are missing.", "error");
        return;
    }

    panel.classList.add("show");

    status.className = "status-box status-info";
    status.textContent = "Loading security report...";

    try {
        if (!securityData) {
            await loadReport();
        }

        if (!securityData) {
            throw new Error("Security data is unavailable.");
        }

        const summary = getSummary();

        const output = {
            report_name: "SENTINELFORGE Security Report",
            source: securityData.source || "SENTINELFORGE API",
            timestamp: securityData.timestamp || null,

            controller: securityData.controller || {},
            hosts: securityData.hosts || [],

            summary: {
                total_checks: summary.total,
                passed: summary.passed,
                failed: summary.failed,
                info: summary.info,
                unknown: summary.unknown,

                compliance_score: Number(
                    summary.compliance.toFixed(1)
                ),

                risk_score: Number(
                    summary.risk.toFixed(1)
                )
            },

            rules: getRules()
        };

        viewer.textContent = JSON.stringify(output, null, 2);

        status.className = "status-box status-success";
        status.textContent =
            "Current security report loaded successfully.";

        panel.scrollIntoView({ behavior: "smooth" });

    } catch (error) {
        console.error(error);

        status.className = "status-box status-error";
        status.textContent =
            "Unable to display the security report.";

        viewer.textContent = "";
    }
}


/* =========================================================
   DOWNLOAD CURRENT SECURITY REPORT AS JSON
   ========================================================= */

async function downloadJSON() {
    try {
        if (!securityData) {
            await loadReport();
        }

        if (!securityData) {
            throw new Error("Security data is unavailable.");
        }

        const summary = getSummary();

        const output = {
            report_name: "SENTINELFORGE Security Report",
            source: securityData.source || "SENTINELFORGE API",
            timestamp: securityData.timestamp || null,

            controller: securityData.controller || {},
            hosts: securityData.hosts || [],

            summary: {
                total_checks: summary.total,
                passed: summary.passed,
                failed: summary.failed,
                info: summary.info,
                unknown: summary.unknown,

                compliance_score: Number(
                    summary.compliance.toFixed(1)
                ),

                risk_score: Number(
                    summary.risk.toFixed(1)
                )
            },

            rules: getRules()
        };

        const blob = new Blob(
            [JSON.stringify(output, null, 2)],
            { type: "application/json" }
        );

        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");

        link.href = url;
        link.download = "sentinelforge-security-report.json";

        document.body.appendChild(link);
        link.click();
        link.remove();

        setTimeout(() => URL.revokeObjectURL(url), 1000);

        showToast(
            "JSON report downloaded successfully.",
            "success"
        );

    } catch (error) {
        console.error(error);

        showToast(
            "Unable to download the JSON report.",
            "error"
        );
    }
}


/* =========================================================
   GENERATE PRINTABLE REPORT
   This opens the browser print dialog.
   It does not save a PDF on the server.
   ========================================================= */

function generatePDF() {
    if (!securityData) {
        showToast(
            "Report data is still loading. Try again.",
            "error"
        );

        return;
    }

    const summary = getSummary();
    const rules = getRules();

    const rows = rules.map(rule => `
        <tr>
            <td>${escapeHTML(rule.hostname || "-")}</td>
            <td>${escapeHTML(rule.name || rule.rule_id || "-")}</td>
            <td>${escapeHTML(rule.severity || "-")}</td>
            <td>${escapeHTML(rule.status || "UNKNOWN")}</td>
            <td>${escapeHTML(rule.expected || "-")}</td>
            <td>${escapeHTML(rule.actual || "-")}</td>
        </tr>
    `).join("");

    const generated = new Date().toLocaleString();

    const printWindow = window.open("", "_blank");

    if (!printWindow) {
        showToast(
            "Allow pop-ups to generate the printable report.",
            "error"
        );

        return;
    }

    const controller = securityData.controller || {};

    const controllerOS = [
        controller.operating_system,
        controller.os_release
    ].filter(Boolean).join(" ");

    printWindow.document.write(`
        <!DOCTYPE html>
        <html lang="en">
        <head>
            <meta charset="UTF-8">

            <title>SENTINELFORGE Security Report</title>

            <style>
                body {
                    font-family: Arial, sans-serif;
                    margin: 28px;
                    color: #111827;
                }

                h1, h2 {
                    color: #111827;
                }

                .summary {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 18px;
                    margin: 20px 0;
                }

                .summary div {
                    border: 1px solid #d1d5db;
                    padding: 12px;
                    min-width: 120px;
                }

                table {
                    width: 100%;
                    border-collapse: collapse;
                    font-size: 10px;
                }

                th, td {
                    border: 1px solid #d1d5db;
                    padding: 6px;
                    text-align: left;
                    overflow-wrap: anywhere;
                }

                th {
                    background: #f3f4f6;
                }

                @media print {
                    body {
                        margin: 12mm;
                    }

                    tr {
                        break-inside: avoid;
                    }
                }
            </style>
        </head>

        <body>
            <h1>SENTINELFORGE</h1>
            <h2>Security Compliance Report</h2>

            <p>Generated: ${escapeHTML(generated)}</p>

            <p>
                Source:
                ${escapeHTML(securityData.source || "SENTINELFORGE API")}
            </p>

            <p>
                Controller:
                ${escapeHTML(controllerOS || "Unavailable")}
            </p>

            <p>
                Hosts:
                ${escapeHTML((securityData.hosts || []).join(", "))}
            </p>

            <p>
                Report timestamp:
                ${escapeHTML(securityData.timestamp || "Unavailable")}
            </p>

            <div class="summary">
                <div>
                    <strong>Total checks</strong>
                    <p>${summary.total}</p>
                </div>

                <div>
                    <strong>Passed</strong>
                    <p>${summary.passed}</p>
                </div>

                <div>
                    <strong>Failed</strong>
                    <p>${summary.failed}</p>
                </div>

                <div>
                    <strong>INFO</strong>
                    <p>${summary.info}</p>
                </div>

                <div>
                    <strong>UNKNOWN</strong>
                    <p>${summary.unknown}</p>
                </div>

                <div>
                    <strong>Compliance</strong>
                    <p>${formatPercent(summary.compliance)}</p>
                </div>

                <div>
                    <strong>Risk</strong>
                    <p>${formatPercent(summary.risk)}</p>
                </div>
            </div>

            <h2>Security Checks</h2>

            <table>
                <thead>
                    <tr>
                        <th>Host</th>
                        <th>Check</th>
                        <th>Severity</th>
                        <th>Status</th>
                        <th>Expected</th>
                        <th>Actual</th>
                    </tr>
                </thead>

                <tbody>
                    ${rows}
                </tbody>
            </table>

            <p>Generated by SENTINELFORGE.</p>

            <script>
                window.onload = function() {
                    window.focus();
                    window.print();
                };
            <\/script>
        </body>
        </html>
    `);

    printWindow.document.close();

    showToast(
        "Printable report opened. Choose Save as PDF in the print dialog.",
        "success"
    );
}


/* =========================================================
   VIEW LATEST SAVED PDF
   ========================================================= */

function viewPDF() {
    const latestPDF = getLatestPDFReport();

    if (!latestPDF) {
        showToast(
            "No saved PDF is available on the server.",
            "info"
        );

        return;
    }

    const url =
        `${API_BASE}/api/reports/pdf/` +
        encodeURIComponent(latestPDF.name);

    window.open(url, "_blank", "noopener,noreferrer");
}


/* =========================================================
   ESCAPE HTML
   ========================================================= */

function escapeHTML(value) {
    if (value === null || value === undefined) {
        return "";
    }

    return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}


/* =========================================================
   INITIALIZATION
   ========================================================= */

document.addEventListener("DOMContentLoaded", loadReport);
